FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libreoffice-writer \
        libreoffice-java-common \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
RUN for i in 1 2 3 4 5; do \
      uv cache clean zstandard >/dev/null 2>&1 || true; \
      uv sync --frozen --group dev --no-install-project && break; \
      if [ "$i" = "5" ]; then exit 1; fi; \
      echo "uv sync failed, retrying in 5s (attempt $i)..."; \
      sleep 5; \
    done

COPY app ./app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    LIBREOFFICE_BINARY=/usr/bin/soffice

EXPOSE 8010

CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8010"]
