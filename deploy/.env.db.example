# Credentials for the shared self-hosted Postgres (deploy/docker-compose.db.yml).
# Copy to deploy/.env.db on the VM and set a strong password.
#
# These MUST match the user:password embedded in DATABASE_URL of BOTH
# .env.dev (db: fairterms_dev) and .env.main (db: fairterms_main), e.g.:
#   DATABASE_URL=postgresql://fairterms:CHANGEME@127.0.0.1:5432/fairterms_dev?schema=public
POSTGRES_USER=fairterms
POSTGRES_PASSWORD=CHANGEME
