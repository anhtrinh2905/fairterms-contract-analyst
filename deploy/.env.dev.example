# Backend runtime — dev stack on VM
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.4-nano-2026-03-17
NEXT_PUBLIC_CLAUSE_CONCURRENCY=10
CHECKLIST_ENABLE_RAG_CITATION_V2=false
CHECKLIST_CITATION_TOP_K=8
CHECKLIST_CITATION_RERANK_TOP_N=5
GROUNDING_JUDGE_MODEL=gpt-5.4-nano-2026-03-17
GROUNDING_SCORE_THRESHOLD=0

# Redis cache for clause evaluation (docker-compose provides the `redis` service)
REDIS_URL=redis://redis:6379/0
CHECKLIST_CACHE_ENABLED=true
CHECKLIST_CACHE_TTL_SECONDS=2592000

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=logs
CHROMA_PERSIST_DIR=.chroma

# Gemini OCR + structuring (3-key pool)
GEMINI_GCP_PLATFORM_KEYS=
GEMINI_AI_STUDIO_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=300
GEMINI_MAX_UPLOAD_MB=50
GEMINI_MAX_IMAGES=30
GEMINI_THINKING_BUDGET=0
GEMINI_IMAGE_MAX_SIDE=0
GEMINI_IMAGE_JPEG_QUALITY=92
GEMINI_PDF_DPI=120
GEMINI_PDF_PAGE_CONCURRENCY=6
GEMINI_OCR_KEY_CONCURRENCY=2
GEMINI_STRUCTURING_MODEL=gemini-2.5-flash
GEMINI_STRUCTURING_MODE=hybrid_safe
GEMINI_STRUCTURING_MODE_DIGITAL=llm_full
GEMINI_STRUCTURING_CONCURRENCY=3
GEMINI_MAX_CONCURRENCY=4
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY=1.0
GEMINI_RETRY_MAX_DELAY=30.0

# Embeddings (RAG)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_OPEN_AI_API_KEY=

# LangSmith — LLM latency + token/cost tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fairterms
LANGSMITH_TRACING=false

# Frontend build arg (baked into image at CI build time)
NEXT_PUBLIC_BACKEND_URL=https://api-dev.c2-app-145.io.vn

# Frontend runtime (NextAuth + Prisma)
# Self-hosted Postgres (deploy/docker-compose.db.yml), database fairterms_dev.
# Use 127.0.0.1 — the frontend entrypoint rewrites the host to `postgres`.
# user:password MUST match deploy/.env.db (POSTGRES_USER / POSTGRES_PASSWORD).
# DATABASE_URL=postgresql://fairterms:CHANGEME@127.0.0.1:5432/fairterms_dev?schema=public
DATABASE_URL=
AUTH_TRUST_HOST=true
AUTH_URL=https://dev.c2-app-145.io.vn
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=https://dev.c2-app-145.io.vn

# Admin page
ADMIN_API_TOKEN=
NEXT_PUBLIC_MOCK_ADMIN=false
ADMIN_EMAILS=
