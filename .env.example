# Analysis provider keys (clause evaluation + RAG answers). First configured wins:
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.4-nano-2026-03-17
NEXT_PUBLIC_CLAUSE_CONCURRENCY=10
CHECKLIST_ENABLE_RAG_CITATION_V2=false
CHECKLIST_CITATION_TOP_K=8
CHECKLIST_CITATION_RERANK_TOP_N=5
GROUNDING_JUDGE_MODEL=gpt-5.4-nano-2026-03-17
GROUNDING_SCORE_THRESHOLD=0

# Redis cache for clause evaluation (fail-open: unset REDIS_URL = no cache).
# Docker Compose provides a `redis` service; point REDIS_URL at it there.
REDIS_URL=
CHECKLIST_CACHE_ENABLED=false
CHECKLIST_CACHE_TTL_SECONDS=2592000

# Gemini — shared 3-key pool for OCR vision + structuring (2 GCP Platform + 1 AI Studio)
GEMINI_GCP_PLATFORM_KEYS=
GEMINI_AI_STUDIO_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=300
GEMINI_MAX_UPLOAD_MB=50
GEMINI_MAX_IMAGES=30
GEMINI_THINKING_BUDGET=0
GEMINI_IMAGE_MAX_SIDE=0
GEMINI_IMAGE_JPEG_QUALITY=92
GEMINI_PDF_DPI=200
GEMINI_PDF_PAGE_CONCURRENCY=6
GEMINI_OCR_KEY_CONCURRENCY=2
GEMINI_STRUCTURING_MODEL=gemini-2.5-flash
GEMINI_STRUCTURING_MODE=hybrid_safe
GEMINI_STRUCTURING_MODE_DIGITAL=llm_full
GEMINI_STRUCTURING_CONCURRENCY=3
GEMINI_MAX_CONCURRENCY=4
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY=1.0
GEMINI_RETRY_MAX_DELAY=30.0

# Logging for backend
LOG_LEVEL=INFO
LOG_DIR=logs

# Config for AI log server
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# Embedding model
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_OPEN_AI_API_KEY=

# LangSmith — LLM latency + token/cost tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fairterms
LANGSMITH_TRACING=false

# Authentication & Database Configuration
# Local self-hosted Postgres (deploy/docker-compose.local.yml). Use 127.0.0.1 —
# the frontend entrypoint rewrites the host to `postgres` inside Docker.
# Credentials must match POSTGRES_USER/POSTGRES_PASSWORD (defaults fairterms/fairterms).
# Example: postgresql://fairterms:fairterms@127.0.0.1:5432/fairterms?schema=public
DATABASE_URL=
# Optional overrides for the local postgres container:
# POSTGRES_USER=fairterms
# POSTGRES_PASSWORD=fairterms
# POSTGRES_DB=fairterms
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of developer email addresses that have unlimited usage quotas
DEV_UNLIMITED_EMAILS=

# Admin page
ADMIN_API_TOKEN=anhquandzai
NEXT_PUBLIC_MOCK_ADMIN=false
ADMIN_EMAILS=

# Cron job auth for POST /api/cron/cleanup (send as header x-cron-secret).
# Use a long random string; required for scheduled deletion of expired analyses.
CRON_SECRET=